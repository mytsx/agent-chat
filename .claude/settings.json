{
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/watch-bot-review.sh\" codex",
            "asyncRewake": true,
            "timeout": 1300,
            "rewakeSummary": "Codex review sonucu",
            "statusMessage": "Codex review'u bekleniyor"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/watch-bot-review.sh\" copilot",
            "asyncRewake": true,
            "timeout": 1200,
            "rewakeSummary": "Copilot review sonucu",
            "statusMessage": "Copilot review'u bekleniyor"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/yerli/Developer/agent-chat/.claude/hooks/notify-done.sh"
          }
        ]
      }
    ]
  }
}
